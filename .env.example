# Console transport: tcp (Waveshare) or serial (direct USB-to-RS232).
PYLONTECH_TRANSPORT=tcp

# Waveshare serial-to-Ethernet gateway (tcp mode).
PYLONTECH_WAVESHARE_HOST=192.168.20.211
PYLONTECH_WAVESHARE_PORT=4196

# Direct USB-to-RS232 settings (serial mode).
PYLONTECH_SERIAL_DEVICE=/dev/pylontech-console
PYLONTECH_SERIAL_BAUDRATE=115200
PYLONTECH_SERIAL_CONNECT_TIMEOUT_SECONDS=5
PYLONTECH_SERIAL_RESPONSE_TIMEOUT_SECONDS=5

# Published host port. The container itself always listens on port 8000.
PYLONTECH_HTTP_PUBLISHED_PORT=8001

# Use main until a versioned beta tag is published, then pin that tag here.
PYLONTECH_IMAGE_TAG=main

# Host-side file containing only the Pylontech console login password.
# Keep its parent directory at mode 700 and the file at mode 644 so the
# non-root container user can read the Compose bind-mounted secret.
PYLONTECH_CONSOLE_PASSWORD_FILE_HOST=./secrets/pylontech-console-password.txt

# MQTT is optional and disabled by default.
PYLONTECH_MQTT_ENABLED=false
PYLONTECH_MQTT_HOST=
PYLONTECH_MQTT_PORT=1883
PYLONTECH_MQTT_CLIENT_ID=pylontech-console
PYLONTECH_MQTT_USERNAME=
PYLONTECH_MQTT_PASSWORD=
PYLONTECH_MQTT_TOPIC_PREFIX=pylontech

# Advanced polling defaults normally do not need adjustment.
PYLONTECH_POLLING_RACK_INTERVAL_SECONDS=5
PYLONTECH_POLLING_MODULE_INTERVAL_SECONDS=60
PYLONTECH_POLLING_INVENTORY_INTERVAL_SECONDS=300
PYLONTECH_POLLING_STALE_AFTER_MULTIPLIER=2

# Cell-voltage heatmap and observational threshold defaults.
PYLONTECH_WEB_HEATMAP_DEADBAND_MV=2
PYLONTECH_WEB_HEATMAP_SCALE_MV=50
PYLONTECH_WEB_CELL_LOW_WARNING_MV=3100
PYLONTECH_WEB_CELL_LOW_CRITICAL_MV=3000
PYLONTECH_WEB_CELL_HIGH_BALANCING_MV=3547
PYLONTECH_WEB_CELL_HIGH_WARNING_MV=3600
